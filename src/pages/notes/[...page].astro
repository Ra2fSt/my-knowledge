---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes } from '../../lib/notes';
import type { NoteEntry } from '../../lib/notes';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const notes = await getNotes();
  return paginate(notes, { pageSize: 10 });
}

const { page } = Astro.props as { page: Page<NoteEntry> };
const pageTitle = page.currentPage === 1 ? '笔记' : `笔记 · 第 ${page.currentPage} 页`;
---

<BaseLayout title={pageTitle}>
  <div class="container page-shell">
    <header class="page-head">
      <p class="eyebrow">ARCHIVE / 笔记</p>
      <h1>全部笔记</h1>
      <p>共 {page.total} 篇，按最近更新排序</p>
    </header>

    <div class="note-list">
      {page.data.map((note, index) => (
        <NoteCard note={note} index={page.start + index + 1} />
      ))}
    </div>

    <nav class="pagination" aria-label="分页">
      {
        page.url.prev ? (
          <a href={page.url.prev}>← 上一页</a>
        ) : (
          <span class="disabled">← 上一页</span>
        )
      }
      <span class="page-info">第 {page.currentPage} / {page.lastPage} 页</span>
      {
        page.url.next ? (
          <a href={page.url.next}>下一页 →</a>
        ) : (
          <span class="disabled">下一页 →</span>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .pagination a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .pagination a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .page-info {
    color: var(--color-text-muted);
  }

  .disabled {
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  @media (max-width: 520px) {
    .pagination {
      font-size: 0.66rem;
    }
  }
</style>
