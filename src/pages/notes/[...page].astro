---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes } from '../../lib/notes';
import type { NoteEntry } from '../../lib/notes';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const notes = await getNotes();
  return paginate(notes, { pageSize: 10 });
}

const { page } = Astro.props as { page: Page<NoteEntry> };
const pageTitle = page.currentPage === 1 ? '笔记' : `笔记 · 第 ${page.currentPage} 页`;
---

<BaseLayout title={pageTitle}>
  <div class="container list-page">
    <header class="list-header">
      <h1>全部笔记</h1>
      <p>共 {page.total} 篇，按最近更新排序</p>
    </header>

    <div class="note-list">
      {page.data.map((note) => <NoteCard note={note} />)}
    </div>

    <nav class="pagination" aria-label="分页">
      {
        page.url.prev ? (
          <a href={page.url.prev}>← 上一页</a>
        ) : (
          <span class="disabled">← 上一页</span>
        )
      }
      <span class="page-info">第 {page.currentPage} / {page.lastPage} 页</span>
      {
        page.url.next ? (
          <a href={page.url.next}>下一页 →</a>
        ) : (
          <span class="disabled">下一页 →</span>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .list-page {
    max-width: var(--article-width);
    margin-inline: auto;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .list-header h1 {
    margin: 0 0 0.4rem;
  }

  .list-header p {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    font-size: 0.92rem;
  }

  .page-info {
    color: var(--color-text-muted);
  }

  .disabled {
    color: var(--color-text-muted);
  }
</style>
