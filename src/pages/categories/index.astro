---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, getCategoryCounts } from '../../lib/notes';

const notes = await getNotes();
const categories = [...getCategoryCounts(notes).entries()];
---

<BaseLayout title="分类">
  <div class="container page-shell">
    <header class="page-head">
      <p class="eyebrow">INDEX / 分类</p>
      <h1>分类</h1>
      <p>共 {categories.length} 个分类 · 按笔记数量排列</p>
    </header>

    <ul class="cat-list">
      {
        categories.map(([category, count], index) => (
          <li>
            <a href={`/categories/${encodeURIComponent(category)}/`}>
              <span class="cat-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="cat-name">{category}</span>
              <span class="cat-leader" aria-hidden="true"></span>
              <span class="cat-count">{count} 篇</span>
              <span class="cat-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .cat-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat-list li {
    border-top: 1px solid var(--color-border);
  }

  .cat-list a {
    display: grid;
    grid-template-columns: 2.4rem auto minmax(2rem, 1fr) auto auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0.3rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .cat-list a:hover {
    background: var(--color-sky-soft);
    color: var(--color-accent);
  }

  .cat-index {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .cat-name {
    font-family: var(--font-display);
    font-size: 1.18rem;
    letter-spacing: -0.01em;
  }

  .cat-leader {
    align-self: center;
    border-bottom: 1px dotted var(--color-border-strong);
    transform: translateY(-0.1em);
  }

  .cat-count {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .cat-arrow {
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .cat-list a {
      grid-template-columns: 1.8rem auto 1fr auto;
      gap: 0.7rem;
      padding: 0.9rem 0.15rem;
    }

    .cat-leader {
      display: none;
    }

    .cat-arrow {
      display: none;
    }

    .cat-name {
      font-size: 1.05rem;
    }
  }
</style>
