---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, getCategoryCounts } from '../../lib/notes';

const notes = await getNotes();
const categories = [...getCategoryCounts(notes).entries()];
---

<BaseLayout title="分类">
  <div class="container list-page">
    <header class="list-header">
      <h1>分类</h1>
      <p>共 {categories.length} 个分类</p>
    </header>

    <ul class="cat-list">
      {categories.map(([category, count]) => (
        <li>
          <a href={`/categories/${encodeURIComponent(category)}/`}>
            <span class="cat-name">{category}</span>
            <span class="count">{count} 篇</span>
            <span class="arrow">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .list-page {
    max-width: var(--article-width);
    margin-inline: auto;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .list-header h1 {
    margin: 0 0 0.4rem;
  }

  .list-header p {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cat-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 500;
  }

  .cat-list a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

  .count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .arrow {
    margin-left: auto;
    color: var(--color-text-muted);
  }
</style>
