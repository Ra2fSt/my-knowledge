---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes, notesByCategory, UNCATEGORIZED } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  const categorySet = new Set(notes.map((n) => n.data.category ?? UNCATEGORIZED));
  return [...categorySet].map((category) => ({ params: { category } }));
}

const category = Astro.params.category ?? '';
const notes = await getNotes();
const inCategory = notesByCategory(notes, category);
---

<BaseLayout title={`分类：${category}`}>
  <div class="container page-shell">
    <header class="page-head">
      <p class="eyebrow">
        <a href="/categories/">分类</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </p>
      <h1>{category}</h1>
      <p>
        {inCategory.length} 篇笔记 · <a href="/categories/">← 全部分类</a>
      </p>
    </header>

    <div class="note-list">
      {inCategory.map((note, index) => <NoteCard note={note} index={index + 1} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .eyebrow a {
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
