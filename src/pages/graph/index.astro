---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import { getNotes } from '../../lib/notes';
import { buildGlobalGraph, categoryColor } from '../../lib/graph';

const notes = await getNotes();
const graph = buildGlobalGraph(notes);
// 图例：入选节点出现过的分类
const legend = [...new Set(graph.nodes.map((n) => n.category))];
---

<BaseLayout title="知识图谱" description="以节点与连线呈现笔记之间的双链关系">
  <div class="graph-page">
    <KnowledgeGraph nodes={graph.nodes} links={graph.links} client:visible />

    <div class="graph-info">
      <div class="graph-desc">
        <h1>知识图谱</h1>
        <p>
          每个节点是一篇笔记，颜色代表分类，连线代表双链引用。点击节点打开笔记，拖动节点可整理布局，滚轮缩放。
        </p>
      </div>

      {
        legend.length > 0 && (
          <div class="graph-legend">
            {legend.map((category) => (
              <span class="legend-item">
                <span class="legend-dot" style={`background:${categoryColor(category)}`}></span>
                {category}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* 满屏布局：页头与页脚之间的空间全给图谱，说明与图例在画布外、图谱下方一行 */
  .graph-page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem 0;
  }

  .graph-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.9rem 0 1.1rem;
  }

  .graph-desc {
    max-width: 480px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .graph-desc h1 {
    font-size: 1.1rem;
    margin: 0 0 0.3rem;
    color: var(--color-text);
  }

  .graph-desc p {
    margin: 0;
    line-height: 1.6;
  }

  .graph-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.7rem 1rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .legend-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
</style>
