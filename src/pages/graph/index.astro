---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import { getNotes } from '../../lib/notes';
import { buildGlobalGraph } from '../../lib/graph';
const notes = await getNotes();
const graph = buildGlobalGraph(notes);
---

<BaseLayout title="知识图谱" description="用学科颜色与关系线宽探索知识联系。">
  <div class="container graph-page">
    <header>
      <div><p>EXPLORE / 知识之间的联系</p><h1>一张会生长的地图</h1></div><a href="/learn/"
        >返回学习地图 →</a>
    </header>
    <p class="hint">
      颜色区分学科；细线是引用，较粗的线是支撑或核心联系。悬停连线可读说明，点击节点打开笔记。
    </p>
    {
      notes.length > graph.nodes.length && (
        <p class="hint">
          当前按连接度展示前 {graph.nodes.length} / {notes.length} 篇笔记。
        </p>
      )
    }
    <KnowledgeGraph nodes={graph.nodes} links={graph.links} height={600} controls />
  </div>
</BaseLayout>
<style>
  .graph-page {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  header p {
    font-size: 0.73rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 0;
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0.4rem 0;
  }
  header > a {
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0.7rem 0 1.3rem;
  }
  @media (max-width: 600px) {
    header {
      align-items: start;
    }
    header > a {
      font-size: 0.75rem;
      white-space: normal;
    }
  }
</style>
