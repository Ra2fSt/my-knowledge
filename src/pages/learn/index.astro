---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes } from '../../lib/notes';
import { SUBJECTS, COVERAGE_LABELS } from '../../lib/subjects';
const notes = await getNotes();
const study = notes.filter((n) => n.data.section === 'computer-foundations');
const chapters = (id: string) =>
  study.filter((n) => n.data.parent === id).sort((a, b) => a.data.order - b.data.order);
const overview = (id: string) => study.find((n) => n.id === id)!;
---

<BaseLayout
  title="计算机基础 · 学习地图"
  description="408 四科与数字逻辑、编译原理、汇编的学习地图、章节考点与知识联系。"
>
  <div class="container study-page">
    <nav class="eyebrow breadcrumb" aria-label="路径">
      <a href="/">知识花园</a><span aria-hidden="true">/</span>计算机基础
    </nav>

    <header class="study-hero">
      <div class="hero-copy">
        <p class="eyebrow">COMPUTER SCIENCE / 学习地图</p>
        <h1>把知识连起来，<br /><em>让理解长出来。</em></h1>
        <p class="intro">
          从算法到电路，从一条指令到整个系统。<br />四科主干，三条旁支，一张可以持续生长的学习地图。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/notes/cs-foundations/">
            阅读总导航 <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/graph/?scope=computer">探索知识联系 →</a>
        </div>
      </div>
      <aside class="study-summary">
        <span class="summary-number">04 <small>+ 03</small></span>
        <h2>主干学科与专业旁支</h2>
        <p>
          {study.length} 篇学习笔记 · {
            chapters('ds-overview').length + chapters('co-overview').length
          } 个核心章节地图
        </p>
        <div class="summary-divider"></div>
        <p>
          <b>先学懂，再填满</b><br />计组与数据结构总览已建<br />本学期旁支：数字逻辑
        </p>
        <span class="tiny">内容完整度 ≠ 个人掌握程度</span>
      </aside>
    </header>

    <section aria-labelledby="core-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / CORE</p>
          <h2 id="core-title">408 四科主干</h2>
        </div>
        <span>从总览进入，逐章向下生长</span>
      </div>
      <div class="subject-grid">
        {
          SUBJECTS.filter((s) => !s.branch).map((s) => (
            <article class="subject-card" style={`--subject:${s.color}`}>
              <div class="card-top">
                <span class="subject-code">{s.code}</span>
                <span class="coverage">{COVERAGE_LABELS[overview(s.id).data.coverage]}</span>
              </div>
              <h3>
                <a href={`/notes/${s.id}/`}>
                  {s.name}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{s.description}</p>
              {chapters(s.id).length ? (
                <ol class="chapter-list">
                  {chapters(s.id).map((n) => (
                    <li>
                      <a href={`/notes/${n.id}/`}>{n.data.title.split(' · ').pop()}</a>
                    </li>
                  ))}
                </ol>
              ) : (
                <div class="outline-note">
                  <p>
                    {s.code === 'OS'
                      ? '进程与线程 / 同步与死锁 / 内存管理 / 文件系统 / I/O'
                      : '物理层 / 链路层 / 网络层 / 传输层 / 应用层'}
                  </p>
                  <span>已有章节规划与填充任务，等待展开。</span>
                </div>
              )}
              <a class="card-entry" href={`/notes/${s.id}/`}>
                打开学科总览 <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="branch-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / BRANCHES</p>
          <h2 id="branch-title">向外生长的旁支</h2>
        </div>
        <span>与主干互相解释，而非孤立背诵</span>
      </div>
      <div class="branch-grid">
        {
          SUBJECTS.filter((s) => s.branch).map((s) => (
            <a class="branch-card" href={`/notes/${s.id}/`} style={`--subject:${s.color}`}>
              <span class="subject-code">{s.code}</span>
              <h3>
                {s.name} <span aria-hidden="true">↗</span>
              </h3>
              <p>{s.description}</p>
              <span class="tiny">
                {s.id === 'digital-logic'
                  ? '本学期优先 · 电路 → ALU → CPU'
                  : s.id === 'compiler'
                    ? '树与图 → 程序分析 → 指令'
                    : '栈与地址 → 指令 → 数据通路'}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="connections">
      <div>
        <p class="eyebrow">03 / CONNECTIONS</p>
        <h2>同一个问题，换个层次理解</h2>
        <p>颜色标识学科，线宽标识关系强度。<br />强联系有明确解释，不以引用次数代替重要性。</p>
        <a href="/graph/?scope=computer">打开可筛选图谱 →</a>
      </div>
      <ol>
        <li>
          <span>01</span>
          <div>
            <b>一次数组遍历</b>
            <p>
              <a href="/notes/ds-linear/">线性表</a> → <a href="/notes/co-memory/">缓存局部性</a> →
              <a href="/notes/os-overview/">虚拟内存</a>
            </p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <b>一次函数调用</b>
            <p>
              <a href="/notes/ds-stack-queue/">栈与递归</a> → <a href="/notes/assembly/">栈帧</a> →
              <a href="/notes/co-cpu/">指令执行</a>
            </p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <b>从逻辑门到处理器</b>
            <p>
              <a href="/notes/digital-logic/">数字逻辑</a> →
              <a href="/notes/co-arithmetic/">运算器</a> →
              <a href="/notes/co-cpu/">控制与流水线</a>
            </p>
          </div>
        </li>
      </ol>
    </section>

    <footer class="study-footer">
      <p>缺少前置知识？<a href="/notes/cs-prerequisites/">C 语言与离散数学补漏 →</a></p>
      <p>按常见课程体系组织；考试范围请以目标年份官方大纲为准。</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .study-page {
    padding-top: 2.2rem;
    padding-bottom: 3rem;
  }

  .breadcrumb {
    margin-bottom: 1.6rem;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .study-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.8fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding: 1.5rem 0 4.5rem;
  }

  .study-hero h1 {
    margin: 0.9rem 0 1.4rem;
    font-size: clamp(2.5rem, 5.5vw, 4.4rem);
    line-height: 1.16;
    letter-spacing: -0.04em;
  }

  .study-hero h1 em {
    font-style: normal;
    color: var(--color-accent);
    background-image: linear-gradient(transparent 74%, var(--color-sun-soft) 0);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .intro {
    max-width: 30em;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.8rem;
  }

  .study-summary {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-sun);
    background: var(--color-surface);
  }

  .summary-number {
    display: block;
    font-family: var(--font-display);
    font-size: 3.8rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.06em;
    color: var(--color-accent);
  }

  .summary-number small {
    font-size: 1.4rem;
    color: var(--color-text-muted);
  }

  .study-summary h2 {
    margin: 1rem 0 0.5rem;
    font-size: 1.05rem;
  }

  .study-summary p {
    margin: 0.4rem 0;
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.8;
  }

  .summary-divider {
    height: 1px;
    margin: 1.3rem 0;
    background: var(--color-border);
  }

  .tiny {
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 3.2rem 0 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .section-heading h2 {
    margin: 0.35rem 0 0;
    font-size: 1.65rem;
  }

  .section-heading > span {
    max-width: 14em;
    padding-bottom: 0.2rem;
    text-align: right;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .subject-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .subject-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--subject);
    background: var(--color-surface);
    transition: background 0.2s ease;
  }

  .subject-card:hover {
    background: color-mix(in srgb, var(--color-sky-soft) 52%, var(--color-surface));
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .subject-code {
    display: inline-flex;
    padding: 0.12rem 0.45rem;
    border: 1px solid var(--subject);
    border-left: 4px solid var(--subject);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .coverage {
    padding: 0.14rem 0.45rem;
    background: var(--color-sky-soft);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .subject-card h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.35rem;
  }

  .subject-card h3 a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .subject-card h3 a:hover {
    color: var(--color-accent);
  }

  .subject-card h3 span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .subject-card > p {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .chapter-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.2rem;
    margin: 0.4rem 0 1.3rem;
    padding: 0;
    list-style: none;
    counter-reset: chap;
  }

  .chapter-list li {
    display: flex;
    gap: 0.5rem;
    padding: 0.32rem 0;
    border-top: 1px dotted var(--color-border);
    font-size: 0.82rem;
    counter-increment: chap;
  }

  .chapter-list li::before {
    content: counter(chap, decimal-leading-zero);
    padding-top: 0.18rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
  }

  .chapter-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .chapter-list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .card-entry {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
  }

  .outline-note {
    padding: 0.2rem 0 1.4rem;
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.9;
  }

  .outline-note p {
    margin: 0 0 0.4rem;
  }

  .outline-note span {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .branch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .branch-card {
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--subject);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .branch-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .branch-card h3 {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.9rem 0 0.35rem;
    font-size: 1.15rem;
  }

  .branch-card p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.72;
  }

  .connections {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding: 2.2rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-grass);
    background: var(--color-sky-soft);
  }

  .connections h2 {
    margin: 0.4rem 0 0.8rem;
    font-size: 1.45rem;
  }

  .connections p {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .connections ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .connections li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .connections li:first-child {
    padding-top: 0;
  }

  .connections li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .connections li > span {
    padding-top: 0.32rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-text-muted);
  }

  .connections li b {
    font-size: 0.9rem;
  }

  .connections li p {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
  }

  .study-footer {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .study-footer p {
    margin: 0.35rem 0;
  }

  @media (max-width: 960px) {
    .study-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1rem 0 2.5rem;
    }

    .study-summary {
      max-width: 32rem;
    }

    .subject-grid,
    .branch-grid,
    .connections {
      grid-template-columns: 1fr;
    }

    .connections {
      gap: 1.5rem;
    }
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .section-heading > span {
      max-width: none;
      text-align: left;
    }

    .chapter-list {
      grid-template-columns: 1fr;
    }

    .study-hero h1 {
      font-size: clamp(2.2rem, 10vw, 3rem);
    }

    .connections {
      padding: 1.4rem;
    }

    .study-summary {
      padding: 1.5rem;
    }

    .summary-number {
      font-size: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .branch-card,
    .subject-card {
      transition: none;
    }
  }
</style>
