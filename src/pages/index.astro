---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getNotes, getCategoryCounts, getTagCounts, noteUpdatedAt } from '../lib/notes';
import { formatDate } from '../lib/utils';
import { SUBJECTS } from '../lib/subjects';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const notes = await getNotes();
// 最近更新：默认不展示归档笔记
const recent = notes.filter((n) => n.data.status !== 'archived').slice(0, 8);
const categories = [...getCategoryCounts(notes).entries()];
const tags = [...getTagCounts(notes).entries()];
const topTags = tags.slice(0, 15);
const latest = notes.length > 0 ? formatDate(noteUpdatedAt(notes[0])) : '—';
---

<BaseLayout>
  <section class="hero">
    <p class="home-eyebrow">DIGITAL GARDEN / 持续生长的知识</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
    <p class="stats">
      共 {notes.length} 篇笔记 · {categories.length} 个分类 · {tags.length} 个标签 · 最近更新 {
        latest
      }
    </p>
  </section>

  <section class="container learning-entry" aria-labelledby="learning-title">
    <div class="learning-card">
      <div>
        <p class="home-eyebrow">新的大章节 / COMPUTER SCIENCE</p><h2 id="learning-title">
          计算机基础，开始连成一张网。
        </h2><p>
          408 四科主干 + 数电、编译、汇编旁支。<br />先看计组与数据结构总览，再沿知识联系向下探索。
        </p><div class="learning-actions">
          <a href="/learn/">进入学习地图 ↗</a><a href="/graph/?scope=computer">查看关系图谱 →</a>
        </div>
      </div><div class="subject-shortcuts">
        {
          SUBJECTS.map((subject) => (
            <a href={'/notes/' + subject.id + '/'} style={'--subject:' + subject.color}>
              <span>{subject.code}</span>
              {subject.name}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <div class="container home-grid">
    <section class="panel">
      <h2>最近更新</h2>
      {
        recent.length > 0 ? (
          <div>
            {recent.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        ) : (
          <p class="empty">暂无笔记</p>
        )
      }
      <p class="panel-more"><a href="/notes/">查看全部笔记 →</a></p>
    </section>

    <section class="panel">
      <h2>分类</h2>
      {
        categories.length > 0 ? (
          <ul class="chip-list">
            {categories.map(([category, count]) => (
              <li>
                <a href={`/categories/${encodeURIComponent(category)}/`}>
                  {category}
                  <span class="count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">暂无分类</p>
        )
      }
    </section>

    <section class="panel">
      <h2>热门标签</h2>
      {
        topTags.length > 0 ? (
          <ul class="chip-list">
            {topTags.map(([tag, count]) => (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag}
                  <span class="count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">暂无标签</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 1.5rem 2.5rem;
    text-align: center;
  }

  .hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .lead {
    margin: 0 auto;
    max-width: 42ch;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .stats {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .panel {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .panel:first-child {
    grid-row: span 2;
  }

  .panel h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }

  .panel-more {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .empty {
    margin: 0;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    background: var(--color-subtle);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .chip-list a:hover {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    text-decoration: none;
  }

  .count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .panel:first-child {
      grid-row: auto;
    }
  }
</style>

<style>
  .home-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }
  .learning-entry {
    margin-bottom: 1.8rem;
  }
  .learning-card {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    border-top: 3px solid var(--color-accent);
  }
  .learning-card h2 {
    font-size: 1.65rem;
    margin: 0.5rem 0 1rem;
  }
  .learning-card p:not(.home-eyebrow) {
    font-size: 0.93rem;
    color: var(--color-text-secondary);
  }
  .learning-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-size: 0.9rem;
    margin-top: 1.3rem;
  }
  .learning-actions a:first-child {
    font-weight: 700;
  }
  .subject-shortcuts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }
  .subject-shortcuts a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0.7rem;
    border-left: 3px solid var(--subject);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.85rem;
    border-radius: 0 4px 4px 0;
  }
  .subject-shortcuts span:first-child {
    font: 0.7rem var(--font-mono);
    width: 2.4rem;
    color: var(--color-text-muted);
  }
  .subject-shortcuts span:last-child {
    margin-left: auto;
    color: var(--color-text-muted);
  }
  @media (max-width: 760px) {
    .learning-card {
      grid-template-columns: 1fr;
      padding: 1.3rem;
      gap: 1.3rem;
    }
    .learning-card h2 {
      font-size: 1.35rem;
    }
  }
</style>
