---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getNotes, getCategoryCounts, getTagCounts, noteUpdatedAt } from '../lib/notes';
import { formatDate } from '../lib/utils';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const notes = await getNotes();
// 最近更新：默认不展示归档笔记
const recent = notes.filter((n) => n.data.status !== 'archived').slice(0, 8);
const categories = [...getCategoryCounts(notes).entries()];
const tags = [...getTagCounts(notes).entries()];
const topTags = tags.slice(0, 15);
const latest = notes.length > 0 ? formatDate(noteUpdatedAt(notes[0])) : '—';
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
    <p class="stats">
      共 {notes.length} 篇笔记 · {categories.length} 个分类 · {tags.length} 个标签 · 最近更新 {latest}
    </p>
  </section>

  <div class="container home-grid">
    <section class="panel">
      <h2>最近更新</h2>
      {
        recent.length > 0 ? (
          <div>
            {recent.map((note) => <NoteCard note={note} />)}
          </div>
        ) : (
          <p class="empty">暂无笔记</p>
        )
      }
      <p class="panel-more"><a href="/notes/">查看全部笔记 →</a></p>
    </section>

    <section class="panel">
      <h2>分类</h2>
      {
        categories.length > 0 ? (
          <ul class="chip-list">
            {categories.map(([category, count]) => (
              <li>
                <a href={`/categories/${encodeURIComponent(category)}/`}>
                  {category}<span class="count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">暂无分类</p>
        )
      }
    </section>

    <section class="panel">
      <h2>热门标签</h2>
      {
        topTags.length > 0 ? (
          <ul class="chip-list">
            {topTags.map(([tag, count]) => (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag}<span class="count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">暂无标签</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 1.5rem 2.5rem;
    text-align: center;
  }

  .hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .lead {
    margin: 0 auto;
    max-width: 42ch;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .stats {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .panel {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .panel:first-child {
    grid-row: span 2;
  }

  .panel h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }

  .panel-more {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .empty {
    margin: 0;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    background: var(--color-subtle);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .chip-list a:hover {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    text-decoration: none;
  }

  .count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .panel:first-child {
      grid-row: auto;
    }
  }
</style>
