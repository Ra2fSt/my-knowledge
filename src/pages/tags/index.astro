---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, getTagCounts } from '../../lib/notes';

const notes = await getNotes();
const tags = [...getTagCounts(notes).entries()];
// 字号按标签数量分级：0.85rem ~ 1.45rem
const maxCount = tags.length > 0 ? tags[0][1] : 1;
---

<BaseLayout title="标签">
  <div class="container page-shell">
    <header class="page-head">
      <p class="eyebrow">INDEX / 标签</p>
      <h1>标签</h1>
      <p>共 {tags.length} 个标签 · 字号表示笔记数量</p>
    </header>

    <ul class="tag-cloud">
      {
        tags.map(([tag, count]) => {
          const size = 0.85 + (count / maxCount) * 0.6;
          return (
            <li style={`--tag-size:${size.toFixed(2)}rem`}>
              <a href={`/tags/${encodeURIComponent(tag)}/`}>
                <span class="tag-hash" aria-hidden="true">
                  #
                </span>
                <span>{tag}</span>
                <sup>{count}</sup>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.6rem;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .tag-cloud li {
    line-height: 1.35;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12rem;
    padding-bottom: 0.12rem;
    border-bottom: 1px solid transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--tag-size);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .tag-cloud a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .tag-hash {
    margin-right: 0.1rem;
    font-size: 0.62em;
    color: var(--color-text-muted);
  }

  .tag-cloud sup {
    margin-left: 0.28rem;
    font-family: var(--font-mono);
    font-size: 0.55em;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .tag-cloud {
      gap: 0.55rem 1.15rem;
    }

    .tag-cloud a {
      font-size: min(var(--tag-size), 1.15rem);
    }
  }
</style>
