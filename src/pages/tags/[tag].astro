---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes, notesByTag } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  const tagSet = new Set(notes.flatMap((n) => n.data.tags));
  return [...tagSet].map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag ?? '';
const notes = await getNotes();
const withTag = notesByTag(notes, tag);
---

<BaseLayout title={`标签：${tag}`}>
  <div class="container page-shell">
    <header class="page-head">
      <p class="eyebrow">
        <a href="/tags/">标签</a>
        <span aria-hidden="true">/</span>
        <span>#{tag}</span>
      </p>
      <h1>#{tag}</h1>
      <p>
        {withTag.length} 篇笔记 · <a href="/tags/">← 全部标签</a>
      </p>
    </header>

    <div class="note-list">
      {withTag.map((note, index) => <NoteCard note={note} index={index + 1} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .eyebrow a {
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
