---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import StatusBadge from '../components/StatusBadge.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { formatDate } from '../lib/utils';
import { noteUpdatedAt, UNCATEGORIZED } from '../lib/notes';
import type { NoteEntry } from '../lib/notes';
import type { GraphData } from '../lib/graph';
import { getNotes } from '../lib/notes';
import { COVERAGE_LABELS, RELATION_LABELS, categoryColor } from '../lib/subjects';

interface Props {
  note: NoteEntry;
  headings: MarkdownHeading[];
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
  outbound: NoteEntry[];
  backlinks: NoteEntry[];
  related: NoteEntry[];
  localGraph: GraphData;
}

const { note, headings, prev, next, outbound, backlinks, related, localGraph } = Astro.props;
const { title, description, category, tags, status, pubDate } = note.data;
const updated = noteUpdatedAt(note);
const subject = categoryColor(category ?? UNCATEGORIZED);
const allNotes = await getNotes();
const byId = new Map(allNotes.map((n) => [n.id, n]));
const ancestors: NoteEntry[] = [];
let parent = note.data.parent;
while (parent && byId.has(parent)) {
  const n = byId.get(parent)!;
  ancestors.unshift(n);
  parent = n.data.parent;
}
const children = allNotes
  .filter((n) => n.data.parent === note.id)
  .sort((a, b) => a.data.order - b.data.order);
const incoming = allNotes.flatMap((n) =>
  n.data.relations.filter((r) => r.target === note.id).map((r) => ({ source: n, relation: r })),
);
---

<BaseLayout title={title} description={description}>
  <div class="note-layout container">
    <article class="note-article" data-pagefind-body>
      {
        note.data.section && (
          <nav class="breadcrumbs" aria-label="章节路径" data-pagefind-ignore>
            <a href="/learn/">计算机基础</a>
            {ancestors
              .filter((n) => n.data.kind !== 'hub')
              .map((n) => (
                <>
                  <span aria-hidden="true">/</span>
                  <a href={'/notes/' + n.id + '/'}>{n.data.title}</a>
                </>
              ))}
            <>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{title}</span>
            </>
          </nav>
        )
      }

      <header class="note-header" style={`--note-subject:${subject}`}>
        <p class="note-kicker">
          <span class="kicker-mark" aria-hidden="true"></span>
          <span>
            {note.data.section ? 'COVERAGE / ' + COVERAGE_LABELS[note.data.coverage] : 'NOTE / 笔记'}
          </span>
          {
            note.data.section && (
              <span class="kicker-note">内容完整度与个人掌握状态分开记录</span>
            )
          }
        </p>
        <h1>{title}</h1>
        {description && <p class="note-desc">{description}</p>}
        <div class="note-meta">
          <StatusBadge status={status} />
          <span class="meta-divider" aria-hidden="true">·</span>
          <span>发布于 {formatDate(pubDate)}</span>
          {
            updated.getTime() !== pubDate.getTime() && (
              <>
                <span class="meta-divider" aria-hidden="true">·</span>
                <span>更新于 {formatDate(updated)}</span>
              </>
            )
          }
          <span class="meta-divider" aria-hidden="true">·</span>
          <a href={`/categories/${encodeURIComponent(category ?? UNCATEGORIZED)}/`}>
            {category ?? UNCATEGORIZED}
          </a>
          {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </header>

      {
        note.data.section && (
          <details class="mobile-toc" data-pagefind-ignore>
            <summary>本页目录</summary>
            <Toc headings={headings} />
          </details>
        )
      }

      <div class="note-content">
        <slot />
      </div>

      {
        (note.data.relations.length > 0 || incoming.length > 0) && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">关系说明</h2>
            <p class="section-hint">
              1 弱关联 · 2 支撑联系 · 3 核心联系；箭头文字说明关系方向，线宽不代表考试频率。
            </p>
            <ul class="relation-list">
              {note.data.relations.map((r) => (
                <li>
                  <div class="relation-line">
                    <strong>
                      {r.strength}/3 · {RELATION_LABELS[r.type]}
                    </strong>
                    <span class="relation-arrow" aria-hidden="true">
                      →
                    </span>
                    <a href={'/notes/' + r.target + '/'}>{byId.get(r.target)?.data.title}</a>
                  </div>
                  <p>{r.reason}</p>
                </li>
              ))}
              {incoming.map(({ source, relation: r }) => (
                <li>
                  <div class="relation-line">
                    <a href={'/notes/' + source.id + '/'}>{source.data.title}</a>
                    <span class="relation-arrow" aria-hidden="true">
                      →
                    </span>
                    <strong>
                      {RELATION_LABELS[r.type]}本篇 · {r.strength}/3
                    </strong>
                  </div>
                  <p>{r.reason}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">相关笔记</h2>
            <ul class="related-list">
              {related.map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                  {n.data.description && <span class="related-desc">{n.data.description}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        backlinks.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">反向链接</h2>
            <p class="section-hint">{backlinks.length} 篇笔记链接到这里</p>
            <ul class="backlink-list">
              {backlinks.map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        outbound.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">本笔记链接到</h2>
            <div class="outbound-chips">
              {outbound.map((n) => (
                <a class="chip" href={`/notes/${n.id}/`}>
                  {n.data.title}
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        localGraph.nodes.length > 1 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">局部图谱</h2>
            <p class="section-hint">本笔记与直接相连的笔记（点击节点跳转，可拖动）</p>
            <KnowledgeGraph nodes={localGraph.nodes} links={localGraph.links} height={320} />
          </section>
        )
      }

      <nav class="note-pager" aria-label="笔记导航" data-pagefind-ignore>
        {
          prev ? (
            <a class="pager-item prev" href={`/notes/${prev.id}/`}>
              <span class="pager-label">← 上一篇</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : (
            <span class="pager-item prev disabled">
              <span class="pager-label">← 上一篇</span>
              <span class="pager-title">没有了</span>
            </span>
          )
        }
        {
          next ? (
            <a class="pager-item next" href={`/notes/${next.id}/`}>
              <span class="pager-label">下一篇 →</span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : (
            <span class="pager-item next disabled">
              <span class="pager-label">下一篇 →</span>
              <span class="pager-title">没有了</span>
            </span>
          )
        }
      </nav>
    </article>

    <aside class="note-sidebar" data-pagefind-ignore>
      {
        note.data.section && (
          <section class="chapter-nav">
            <p class="chapter-nav-label">章节</p>
            <a class="chapter-back" href="/learn/">
              ← 返回学科地图
            </a>
            {children.length > 0 && (
              <ul>
                {children.map((n) => (
                  <li>
                    <a href={'/notes/' + n.id + '/'}>{n.data.title.split(' · ').pop()}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 48rem) 15rem;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .note-article {
    min-width: 0;
  }

  .note-header {
    margin-bottom: 2.2rem;
    padding-top: 1.35rem;
    border-top: 3px solid var(--note-subject);
  }

  .note-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .kicker-mark {
    width: 14px;
    height: 3px;
    background: var(--note-subject);
  }

  .kicker-note {
    padding-left: 0.7rem;
    border-left: 1px solid var(--color-border);
    letter-spacing: 0.02em;
  }

  .note-header h1 {
    max-width: 20em;
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.24;
    text-wrap: balance;
  }

  .note-desc {
    max-width: 58ch;
    margin: 0.9rem 0 1.1rem;
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
  }

  .note-meta a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .note-meta a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .meta-divider {
    color: var(--color-border-strong);
  }

  /* 正文排版（slot 内容不受本组件作用域影响，需 :global） */
  .note-content > :global(*:first-child) {
    margin-top: 0;
  }

  .note-content :global(p) {
    margin: 0.95em 0;
  }

  .note-content :global(h2) {
    margin-top: 2.6em;
    padding-top: 1.15rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.58rem;
  }

  .note-content :global(h2)::before {
    content: '';
    display: block;
    width: 2rem;
    height: 2px;
    margin-bottom: 0.85rem;
    background: var(--color-sun);
  }

  .note-content :global(h3) {
    margin-top: 1.9em;
    font-size: 1.18rem;
  }

  .note-content :global(h4) {
    margin-top: 1.6em;
    font-size: 1.05rem;
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    padding-left: 1.35rem;
  }

  .note-content :global(li::marker) {
    color: var(--color-text-muted);
  }

  .note-content :global(blockquote) {
    margin: 1.8em 0;
  }

  .note-content :global(img) {
    border: 1px solid var(--color-border);
  }

  /* 双链样式（slot 内容不受作用域影响，需 :global） */
  .note-content :global(a.wikilink) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .note-content :global(.wikilink-missing) {
    color: var(--color-text-muted);
    border-bottom: 1px dashed var(--color-text-muted);
    cursor: help;
  }

  .link-section {
    margin-top: 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.45rem;
    font-size: 1.22rem;
  }

  .section-title::before {
    content: '';
    width: 1.4rem;
    height: 2px;
    flex-shrink: 0;
    background: var(--color-sun);
  }

  .section-hint {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .relation-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .relation-list li {
    padding: 0.8rem 0;
    border-top: 1px dotted var(--color-border);
  }

  .relation-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .relation-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.9rem;
  }

  .relation-line strong {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .relation-arrow {
    color: var(--color-border-strong);
  }

  .relation-list p {
    margin: 0.3rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.72;
  }

  .related-list,
  .backlink-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-list li,
  .backlink-list li {
    padding: 0.7rem 0;
    border-top: 1px dotted var(--color-border);
  }

  .related-list li:first-child,
  .backlink-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .related-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .related-list a,
  .backlink-list a {
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .related-list a:hover,
  .backlink-list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .related-desc {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .outbound-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .note-sidebar {
    position: sticky;
    top: 5.8rem;
    align-self: start;
  }

  .chapter-nav {
    margin-bottom: 2rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-grass);
    background: var(--color-surface);
  }

  .chapter-nav-label {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .chapter-back {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-size: 0.8rem;
  }

  .chapter-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-nav li {
    border-top: 1px dotted var(--color-border);
  }

  .chapter-nav li a {
    display: block;
    padding: 0.4rem 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.55;
    text-decoration: none;
  }

  .chapter-nav li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .note-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.15rem 1.5rem 0 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .pager-item.next {
    align-items: flex-end;
    padding: 1.15rem 0 0 1.5rem;
    border-left: 1px solid var(--color-border);
    text-align: right;
  }

  .pager-item:hover {
    color: var(--color-accent);
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.5;
  }

  .pager-item.disabled {
    color: var(--color-text-muted);
  }

  .pager-item.disabled .pager-title {
    text-decoration: line-through;
    text-decoration-color: var(--color-border-strong);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-text-secondary);
  }

  .mobile-toc {
    display: none;
    margin: 1.2rem 0;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .mobile-toc summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1000px) {
    .note-layout {
      grid-template-columns: 1fr;
      padding-top: 2.2rem;
    }

    .note-article {
      max-width: 48rem;
    }

    .note-sidebar {
      display: none;
    }

    .mobile-toc {
      display: block;
    }
  }

  @media (max-width: 620px) {
    .note-header h1 {
      font-size: 1.95rem;
    }

    .kicker-note {
      flex-basis: 100%;
      padding-left: 0;
      border-left: 0;
    }

    .note-pager {
      grid-template-columns: 1fr;
    }

    .pager-item.next {
      align-items: flex-start;
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
      text-align: left;
    }
  }
</style>
