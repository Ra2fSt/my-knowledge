---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { formatDate } from '../lib/utils';
import { noteUpdatedAt, UNCATEGORIZED } from '../lib/notes';
import type { NoteEntry } from '../lib/notes';

interface Props {
  note: NoteEntry;
  headings: MarkdownHeading[];
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
}

const { note, headings, prev, next } = Astro.props;
const { title, description, category, tags, status, pubDate } = note.data;
const updated = noteUpdatedAt(note);
---

<BaseLayout title={title} description={description}>
  <div class="note-layout container">
    <article class="note-article">
      <header class="note-header">
        <h1>{title}</h1>
        {description && <p class="note-desc">{description}</p>}
        <div class="note-meta">
          <StatusBadge status={status} />
          <span>发布于 {formatDate(pubDate)}</span>
          {
            updated.getTime() !== pubDate.getTime() && (
              <span>· 更新于 {formatDate(updated)}</span>
            )
          }
          <span>·</span>
          <a href={`/categories/${encodeURIComponent(category ?? UNCATEGORIZED)}/`}>
            {category ?? UNCATEGORIZED}
          </a>
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>
      </header>

      <div class="note-content">
        <slot />
      </div>

      <nav class="note-pager" aria-label="笔记导航">
        {
          prev ? (
            <a class="pager-item prev" href={`/notes/${prev.id}/`}>
              <span>上一篇</span>
              {prev.title}
            </a>
          ) : (
            <span class="pager-item prev disabled">
              <span>上一篇</span>
              没有了
            </span>
          )
        }
        {
          next ? (
            <a class="pager-item next" href={`/notes/${next.id}/`}>
              <span>下一篇</span>
              {next.title}
            </a>
          ) : (
            <span class="pager-item next disabled">
              <span>下一篇</span>
              没有了
            </span>
          )
        }
      </nav>
    </article>

    <aside class="note-sidebar">
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 3rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .note-article {
    min-width: 0;
  }

  .note-header {
    margin-bottom: 2rem;
  }

  .note-header h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .note-desc {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .note-meta a {
    color: var(--color-text-secondary);
  }

  .note-meta a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* 正文排版（slot 内容不受本组件作用域影响，需 :global） */
  .note-content > :global(*:first-child) {
    margin-top: 0;
  }

  .note-content :global(h2) {
    margin-top: 2.2em;
    padding-bottom: 0.35em;
    border-bottom: 1px solid var(--color-border);
  }

  .note-content :global(h3) {
    margin-top: 1.6em;
  }

  .note-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
  }

  .note-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 48%;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .pager-item span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .pager-item.next {
    text-align: right;
  }

  .pager-item.disabled {
    color: var(--color-text-muted);
  }

  @media (max-width: 1000px) {
    .note-layout {
      grid-template-columns: 1fr;
    }

    .note-sidebar {
      display: none;
    }
  }
</style>
