---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import StatusBadge from '../components/StatusBadge.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { formatDate } from '../lib/utils';
import { noteUpdatedAt, UNCATEGORIZED } from '../lib/notes';
import type { NoteEntry } from '../lib/notes';
import type { GraphData } from '../lib/graph';
import { getNotes } from '../lib/notes';
import { COVERAGE_LABELS, RELATION_LABELS, categoryColor } from '../lib/subjects';

interface Props {
  note: NoteEntry;
  headings: MarkdownHeading[];
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
  outbound: NoteEntry[];
  backlinks: NoteEntry[];
  related: NoteEntry[];
  localGraph: GraphData;
}

const { note, headings, prev, next, outbound, backlinks, related, localGraph } = Astro.props;
const { title, description, category, tags, status, pubDate } = note.data;
const updated = noteUpdatedAt(note);
const allNotes = await getNotes();
const byId = new Map(allNotes.map((n) => [n.id, n]));
const ancestors: NoteEntry[] = [];
let parent = note.data.parent;
while (parent && byId.has(parent)) {
  const n = byId.get(parent)!;
  ancestors.unshift(n);
  parent = n.data.parent;
}
const children = allNotes
  .filter((n) => n.data.parent === note.id)
  .sort((a, b) => a.data.order - b.data.order);
const incoming = allNotes.flatMap((n) =>
  n.data.relations.filter((r) => r.target === note.id).map((r) => ({ source: n, relation: r })),
);
---

<BaseLayout title={title} description={description}>
  <div class="note-layout container">
    <article class="note-article" data-pagefind-body>
      {
        note.data.section && (
          <nav class="breadcrumbs" aria-label="章节路径" data-pagefind-ignore>
            <a href="/learn/">计算机基础</a>
            {ancestors
              .filter((n) => n.data.kind !== 'hub')
              .map((n) => (
                <>
                  <span>/</span>
                  <a href={'/notes/' + n.id + '/'}>{n.data.title}</a>
                </>
              ))}
            <>
              <span>/</span>
              <span aria-current="page">{title}</span>
            </>
          </nav>
        )
      }
      <header
        class="note-header"
        style={note.data.section
          ? 'border-top: 3px solid ' +
            categoryColor(category ?? UNCATEGORIZED) +
            ';padding-top:1.2rem'
          : ''}
      >
        {
          note.data.section && (
            <p class="coverage">
              {COVERAGE_LABELS[note.data.coverage]} · 内容完整度与个人掌握状态分开记录
            </p>
          )
        }
        <h1>{title}</h1>
        {description && <p class="note-desc">{description}</p>}
        <div class="note-meta">
          <StatusBadge status={status} />
          <span>发布于 {formatDate(pubDate)}</span>
          {updated.getTime() !== pubDate.getTime() && <span>· 更新于 {formatDate(updated)}</span>}
          <span>·</span>
          <a href={`/categories/${encodeURIComponent(category ?? UNCATEGORIZED)}/`}>
            {category ?? UNCATEGORIZED}
          </a>
          {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </header>

      {
        note.data.section && (
          <details class="mobile-toc" data-pagefind-ignore>
            <>
              <summary>本页目录</summary>
              <Toc headings={headings} />
            </>
          </details>
        )
      }
      <div class="note-content">
        <slot />
      </div>
      {
        (note.data.relations.length > 0 || incoming.length > 0) && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">关系说明</h2>
            <p class="section-hint">
              1 弱关联 · 2 支撑联系 · 3 核心联系；箭头文字说明关系方向，线宽不代表考试频率。
            </p>
            <ul class="relation-list">
              {note.data.relations.map((r) => (
                <li>
                  <strong>
                    {r.strength}/3 · {RELATION_LABELS[r.type]}
                  </strong>{' '}
                  <a href={'/notes/' + r.target + '/'}>{byId.get(r.target)?.data.title}</a>
                  <p>{r.reason}</p>
                </li>
              ))}
              {incoming.map(({ source, relation: r }) => (
                <li>
                  <a href={'/notes/' + source.id + '/'}>{source.data.title}</a> →{' '}
                  <strong>
                    {RELATION_LABELS[r.type]}本篇 · {r.strength}/3
                  </strong>
                  <p>{r.reason}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">相关笔记</h2>
            <ul class="related-list">
              {related.map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                  {n.data.description && <span class="related-desc">{n.data.description}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        backlinks.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">反向链接</h2>
            <p class="section-hint">{backlinks.length} 篇笔记链接到这里</p>
            <ul class="backlink-list">
              {backlinks.map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        outbound.length > 0 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">本笔记链接到</h2>
            <div class="outbound-chips">
              {outbound.map((n) => (
                <a class="chip" href={`/notes/${n.id}/`}>
                  {n.data.title}
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        localGraph.nodes.length > 1 && (
          <section class="link-section" data-pagefind-ignore>
            <h2 class="section-title">局部图谱</h2>
            <p class="section-hint">本笔记与直接相连的笔记（点击节点跳转，可拖动）</p>
            <KnowledgeGraph nodes={localGraph.nodes} links={localGraph.links} height={320} />
          </section>
        )
      }

      <nav class="note-pager" aria-label="笔记导航" data-pagefind-ignore>
        {
          prev ? (
            <a class="pager-item prev" href={`/notes/${prev.id}/`}>
              <span>上一篇</span>
              {prev.title}
            </a>
          ) : (
            <span class="pager-item prev disabled">
              <span>上一篇</span>
              没有了
            </span>
          )
        }
        {
          next ? (
            <a class="pager-item next" href={`/notes/${next.id}/`}>
              <span>下一篇</span>
              {next.title}
            </a>
          ) : (
            <span class="pager-item next disabled">
              <span>下一篇</span>
              没有了
            </span>
          )
        }
      </nav>
    </article>

    <aside class="note-sidebar" data-pagefind-ignore>
      {
        note.data.section && (
          <section class="chapter-nav">
            <a href="/learn/">← 返回学科地图</a>
            {children.length > 0 && (
              <ul>
                {children.map((n) => (
                  <li>
                    <a href={'/notes/' + n.id + '/'}>{n.data.title.split(' · ').pop()}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 3rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .note-article {
    min-width: 0;
  }

  .note-header {
    margin-bottom: 2rem;
  }

  .note-header h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .note-desc {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .note-meta a {
    color: var(--color-text-secondary);
  }

  .note-meta a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* 正文排版（slot 内容不受本组件作用域影响，需 :global） */
  .note-content > :global(*:first-child) {
    margin-top: 0;
  }

  .note-content :global(h2) {
    margin-top: 2.2em;
    padding-bottom: 0.35em;
    border-bottom: 1px solid var(--color-border);
  }

  .note-content :global(h3) {
    margin-top: 1.6em;
  }

  /* 双链样式（slot 内容不受作用域影响，需 :global） */
  .note-content :global(a.wikilink) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .note-content :global(.wikilink-missing) {
    color: var(--color-text-muted);
    border-bottom: 1px dashed var(--color-text-muted);
    cursor: help;
  }

  .link-section {
    margin-top: 2.8rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-border);
  }

  .section-title {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .section-hint {
    margin: 0 0 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .related-list,
  .backlink-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .related-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .related-desc {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .outbound-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

  .note-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
  }

  .note-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 48%;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .pager-item span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .pager-item.next {
    text-align: right;
  }

  .pager-item.disabled {
    color: var(--color-text-muted);
  }

  @media (max-width: 1000px) {
    .note-layout {
      grid-template-columns: 1fr;
    }

    .note-sidebar {
      display: none;
    }
  }
</style>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1.3rem;
  }
  .coverage {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0 0 0.7rem;
  }
  .chapter-nav {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    background: var(--color-surface);
  }
  .chapter-nav p {
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .chapter-nav ul {
    padding-left: 1.1rem;
  }
  .chapter-nav li {
    margin: 0.4rem 0;
  }
  .relation-list {
    padding-left: 1.2rem;
    font-size: 0.9rem;
  }
  .relation-list p {
    margin: 0.2rem 0 1rem;
    color: var(--color-text-secondary);
  }
  .mobile-toc {
    display: none;
    margin: 1rem 0;
    padding: 0.7rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  @media (max-width: 1000px) {
    .mobile-toc {
      display: block;
    }
  }
</style>
