---
// 全文搜索弹窗：基于 Pagefind（构建后生成 /pagefind/ 静态索引）
// 交互：点击头部「搜索」按钮或 Ctrl+K / Cmd+K 打开，Esc 关闭
// 开发模式下 /pagefind/pagefind.js 不存在，弹窗内会给出提示
---

<div
  class="search-overlay"
  id="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="搜索"
  hidden
>
  <div class="search-modal">
    <div class="search-modal-head">
      <span>SEARCH / 全文搜索</span>
      <kbd>Esc</kbd>
    </div>
    <div class="search-box">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.8-3.8"></path>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="搜索标题、正文、标签…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <p class="search-hint">Ctrl+K 打开 · 输入即搜 · 结果带关键词高亮</p>
    <div class="search-status" id="search-status"></div>
    <ul class="search-results" id="search-results"></ul>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const statusEl = document.getElementById('search-status') as HTMLElement;
  const resultsEl = document.getElementById('search-results') as HTMLElement;

  let pagefind: any = null;
  let loadFailed = false;

  function open() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    window.setTimeout(() => input.focus(), 50);
  }

  function close() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    input.value = '';
    resultsEl.innerHTML = '';
    statusEl.textContent = '';
  }

  // 头部搜索按钮（所有页面都有）
  document.querySelectorAll<HTMLElement>('.search-button').forEach((btn) => {
    btn.addEventListener('click', open);
  });

  // Ctrl+K / Cmd+K 切换，Esc 关闭
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.hidden ? open() : close();
    }
    if (e.key === 'Escape' && !overlay.hidden) close();
  });

  // 点击遮罩关闭
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  // 懒加载 Pagefind（构建后才存在，dev 下 import 会失败）
  async function loadPagefind(): Promise<boolean> {
    if (pagefind) return true;
    if (loadFailed) return false;
    try {
      // Pagefind 是构建后生成的静态资源，运行时才存在。
      // 用 new Function 包住 import：构建器看不到它就不会改写（普通写法会被
      // 编译成 import(url, __VITE_PRELOAD__)，而该辅助函数在产物里并不存在，导致运行时报错）。
      const mod = await new Function('p', 'return import(p)')('/pagefind/pagefind.js');
      pagefind = mod;
      await pagefind.options({ showSubResults: false });
      return true;
    } catch (err) {
      loadFailed = true;
      // 区分「开发模式没有索引」（文件不存在）和「真实加载失败」，后者要显示具体原因
      const detail = err instanceof Error ? err.message : String(err);
      try {
        const probe = await fetch('/pagefind/pagefind.js', { method: 'HEAD' });
        statusEl.textContent = probe.ok
          ? `搜索初始化失败：${detail}`
          : '本地开发模式暂无索引：运行 npm run build 后即可搜索。';
      } catch {
        statusEl.textContent = '本地开发模式暂无索引：运行 npm run build 后即可搜索。';
      }
      return false;
    }
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(doSearch, 200);
  });

  // 转义后把查询词包上 <mark>。单遍正则替换 + 长词优先，
  // 避免"短词先包、长词再匹配进 mark 标签里"的嵌套问题。
  function escapeHtml(s: string): string {
    return String(s).replace(/[&<>"']/g, (ch) => {
      return (
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<
          string,
          string
        >)[ch]
      );
    });
  }

  function highlight(text: string, query: string): string {
    const terms = [...new Set(query.split(/\s+/).filter((t) => t.length > 0))].sort(
      (a, b) => b.length - a.length
    );
    let html = escapeHtml(text);
    if (terms.length === 0) return html;
    const pattern = new RegExp(
      terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|'),
      'gi'
    );
    return html.replace(pattern, (m) => `<mark>${m}</mark>`);
  }

  async function doSearch() {
    const query = input.value.trim();
    if (!query) {
      resultsEl.innerHTML = '';
      statusEl.textContent = '';
      return;
    }
    // 失败原因已由 loadPagefind 写入 statusEl，这里不覆盖
    if (!(await loadPagefind())) return;
    statusEl.textContent = '搜索中…';
    const search = await pagefind.search(query);
    const top = search.results.slice(0, 10);
    const items = await Promise.all(top.map((r: any) => r.data()));
    statusEl.textContent =
      items.length > 0 ? `找到 ${search.results.length} 个结果` : '没有找到相关结果';
    resultsEl.innerHTML = items
      .map(
        (item: any) => `
      <li>
        <a href="${item.url}">
          <span class="result-title">${highlight(item.meta.title, query)}</span>
          <span class="result-excerpt">${item.excerpt}</span>
        </a>
      </li>`
      )
      .join('');
  }
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1.25rem 2rem;
    background: var(--color-overlay);
    backdrop-filter: blur(6px) saturate(1.05);
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-modal {
    width: min(680px, 100%);
    max-height: 72vh;
    overflow-y: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-top: 3px solid var(--color-sun);
    padding: 0 0 1rem;
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .search-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  kbd {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    padding: 0.15rem 0.4rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .search-box:focus-within {
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .search-box svg {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-box input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 1.02rem;
  }

  .search-box input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .search-hint {
    margin: 0;
    padding: 0.75rem 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .search-status {
    min-height: 1.2em;
    padding: 0.5rem 1.25rem 0;
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem 1.25rem 0;
  }

  .search-results :global(li) {
    border-top: 1px solid var(--color-border);
  }

  .search-results :global(li:first-child) {
    border-top: 0;
  }

  .search-results :global(a) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 0.6rem;
    border-left: 2px solid transparent;
    color: var(--color-text);
    text-decoration: none;
  }

  .search-results :global(a:hover) {
    background: var(--color-sky-soft);
    border-left-color: var(--color-sun);
  }

  .search-results :global(.result-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .search-results :global(.result-excerpt) {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .search-results :global(mark) {
    background: var(--color-sun-soft);
    color: var(--color-text);
    padding: 0 0.1em;
  }

  @media (max-width: 600px) {
    .search-overlay {
      padding-top: 8vh;
    }

    .search-modal {
      max-height: 82vh;
      box-shadow: 6px 6px 0 color-mix(in srgb, var(--color-ink) 10%, transparent);
    }

    .search-modal-head,
    .search-box,
    .search-hint,
    .search-status,
    .search-results {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
