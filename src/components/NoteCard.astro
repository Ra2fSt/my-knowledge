---
import StatusBadge from './StatusBadge.astro';
import { categoryColor, COVERAGE_LABELS } from '../lib/subjects';
import { formatDate } from '../lib/utils';
import { noteUpdatedAt, UNCATEGORIZED } from '../lib/notes';
import type { NoteEntry } from '../lib/notes';

interface Props {
  note: NoteEntry;
  index: number;
}

const { note, index } = Astro.props;
const { title, description, category, tags, status } = note.data;
const updated = noteUpdatedAt(note);
const number = String(index).padStart(2, '0');
---

<article class="note-card" style={`--subject-color:${categoryColor(category ?? UNCATEGORIZED)}`}>
  <div class="note-index" aria-hidden="true">{number}</div>
  <div class="note-main">
    <h3 class="note-title-row">
      <span class="note-swatch" aria-hidden="true"></span>
      <a class="note-title" href={`/notes/${note.id}/`}>{title}</a>
    </h3>
    {description && <p class="note-description">{description}</p>}
    <div class="note-meta">
      <StatusBadge status={status} />
      {note.data.section && <span>{COVERAGE_LABELS[note.data.coverage]}</span>}
      <span class="meta-divider" aria-hidden="true">·</span>
      <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
      <span class="meta-divider" aria-hidden="true">·</span>
      <a
        class="note-category"
        href={`/categories/${encodeURIComponent(category ?? UNCATEGORIZED)}/`}
      >
        {category ?? UNCATEGORIZED}
      </a>
      {
        tags.length > 0 && (
          <>
            <span class="meta-divider" aria-hidden="true">·</span>
            <span class="note-tags">
              {tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
              ))}
            </span>
          </>
        )
      }
    </div>
  </div>
</article>

<style>
  .note-card {
    display: grid;
    grid-template-columns: 2.7rem minmax(0, 1fr);
    column-gap: 1.1rem;
    padding: 1.15rem 0 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .note-index {
    padding-top: 0.38rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .note-title-row {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: 1.45;
  }

  .note-swatch {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    margin-right: 0.6rem;
    background: var(--subject-color);
    transform: translateY(-0.06em);
  }

  .note-title {
    font-family: var(--font-display);
    font-size: 1.14rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--color-text);
    text-decoration: none;
  }

  .note-title:hover {
    color: var(--color-accent);
  }

  .note-description {
    max-width: 64ch;
    margin: 0.4rem 0 0.65rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.68;
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.42rem 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.02em;
  }

  .note-meta a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .note-meta a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .meta-divider {
    color: var(--color-border-strong);
  }

  .note-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  @media (max-width: 560px) {
    .note-card {
      grid-template-columns: 1.9rem minmax(0, 1fr);
      column-gap: 0.8rem;
    }

    .note-title {
      font-size: 1.03rem;
    }

    .note-meta {
      font-size: 0.64rem;
    }
  }
</style>
