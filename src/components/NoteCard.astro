---
import StatusBadge from './StatusBadge.astro';
import { formatDate } from '../lib/utils';
import { noteUpdatedAt, UNCATEGORIZED } from '../lib/notes';
import type { NoteEntry } from '../lib/notes';

interface Props {
  note: NoteEntry;
}

const { note } = Astro.props;
const { title, description, category, tags, status } = note.data;
const updated = noteUpdatedAt(note);
---

<article class="note-card">
  <a class="note-title" href={`/notes/${note.id}/`}>{title}</a>
  {description && <p class="note-description">{description}</p>}
  <div class="note-meta">
    <StatusBadge status={status} />
    <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
    <span class="sep">·</span>
    <a class="note-category" href={`/categories/${encodeURIComponent(category ?? UNCATEGORIZED)}/`}>
      {category ?? UNCATEGORIZED}
    </a>
    {
      tags.length > 0 && (
        <>
          <span class="sep">·</span>
          <span class="note-tags">
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
            ))}
          </span>
        </>
      )
    }
  </div>
</article>

<style>
  .note-card {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .note-card:last-child {
    border-bottom: none;
  }

  .note-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .note-title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .note-description {
    margin: 0.35rem 0 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .note-category {
    color: var(--color-text-secondary);
  }

  .note-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .note-tags a {
    color: var(--color-text-secondary);
  }

  .note-tags a:hover,
  .note-category:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
