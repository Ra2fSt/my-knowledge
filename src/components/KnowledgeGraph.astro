---
import type { GraphNode, GraphLink } from '../lib/graph';
interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
  height?: number;
  controls?: boolean;
}
const { nodes, links, height = 340, controls = false } = Astro.props;
const data = JSON.stringify({ nodes, links }).replace(/</g, '\\u003c');
const categories = [...new Set(nodes.map((n) => n.category))];
---

<section
  class="knowledge-graph"
  data-height={height}
  data-controls={controls ? 'true' : 'false'}
  data-pagefind-ignore
>
  {
    controls && (
      <div class="graph-toolbar">
        <label>
          范围
          <select data-scope>
            <>
              <option value="all">整个知识花园</option>
              <option value="computer">计算机基础</option>
            </>
          </select>
        </label>
        <label>
          学科
          <select data-category>
            <option value="all">全部学科</option>
            {categories.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </label>
        <label>
          连线
          <select data-strength>
            <>
              <option value="1">全部关系</option>
              <option value="2">支撑与核心 ≥ 2</option>
              <option value="3">只看核心 = 3</option>
            </>
          </select>
        </label>
        <label class="check-label">
          <input type="checkbox" data-labels />
          显示全部标题
        </label>
        <button type="button" data-reset>
          重置视图
        </button>
      </div>
    )
  }
  <div
    class="graph-canvas"
    style={`height:${height}px`}
    role="img"
    aria-label="交互式知识图谱，下方提供可点击的文字节点与关系列表"
  >
  </div>
  <div class="graph-info">
    <span data-count aria-live="polite">{nodes.length} 节点 · {links.length} 关系</span><div
      class="line-legend"
    >
      <span><i style="border-width:1px"></i>1 引用 / 弱关联</span><span
        ><i style="border-width:2.2px"></i>2 支撑</span
      ><span><i style="border-width:3.8px"></i>3 核心 / 章节</span>
    </div>
  </div>
  {
    controls && (
      <div class="category-legend">
        {categories.map((c) => (
          <span data-legend-category={c}>
            <i style={`background:${nodes.find((n) => n.category === c)?.color}`} />
            {c}
          </span>
        ))}
      </div>
    )
  }
  <p class="graph-status" role="status"></p>
  <details class="graph-text">
    <summary>文字视图 · 节点与关系（可键盘访问）</summary><ul data-node-list>
      {
        nodes.map((n) => (
          <li>
            <a href={n.url}>{n.name}</a>
          </li>
        ))
      }
    </ul><ul data-edge-list>
      {
        links.map((l) => (
          <li>
            {l.strength}/3 · {l.descriptions.join('；')}
          </li>
        ))
      }
    </ul>
  </details>
  <script is:inline type="application/json" class="graph-data" set:html={data} />
</section>
<script>
  import type { GraphNode, GraphLink } from '../lib/graph';
  type RenderNode = GraphNode & { x: number; y: number; fx?: number; fy?: number };
  type RenderLink = Omit<GraphLink, 'source' | 'target'> & {
    source: string | RenderNode;
    target: string | RenderNode;
  };
  const escape = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  const id = (node: string | RenderNode) => (typeof node === 'string' ? node : node.id);
  for (const wrapper of document.querySelectorAll<HTMLElement>('.knowledge-graph')) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          void init(wrapper);
        }
      },
      { rootMargin: '180px' },
    );
    observer.observe(wrapper);
  }
  async function init(wrapper: HTMLElement) {
    const canvas = wrapper.querySelector<HTMLElement>('.graph-canvas')!;
    const status = wrapper.querySelector<HTMLElement>('.graph-status')!;
    const raw = JSON.parse(wrapper.querySelector('.graph-data')!.textContent || '{}') as {
      nodes: GraphNode[];
      links: GraphLink[];
    };
    if (!raw.nodes.length) {
      status.textContent = '还没有笔记。';
      return;
    }
    try {
      const { ForceGraph } = await import('../lib/force-graph');
      const scope = wrapper.querySelector<HTMLSelectElement>('[data-scope]');
      const category = wrapper.querySelector<HTMLSelectElement>('[data-category]');
      const strength = wrapper.querySelector<HTMLSelectElement>('[data-strength]');
      const labels = wrapper.querySelector<HTMLInputElement>('[data-labels]');
      const params = new URLSearchParams(location.search);
      if (scope && params.get('scope') === 'computer') scope.value = 'computer';
      if (category && [...category.options].some((o) => o.value === params.get('category')))
        category.value = params.get('category')!;
      let hovered: string | null = null;
      let neighbors = new Set<string>();
      let visibleLinks: RenderLink[] = [];
      let visibleCount = raw.nodes.length;
      let pendingFit = true;
      const css = (name: string) =>
        getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      let textColor = css('--color-text');
      let mutedColor = css('--color-text-muted');
      const draw = (n: RenderNode, ctx: CanvasRenderingContext2D, scale: number) => {
        const active = !hovered || neighbors.has(n.id);
        const radius = Math.max(4, Math.min(10, Math.sqrt(n.val) * 1.8));
        ctx.save();
        ctx.globalAlpha = active ? 1 : 0.16;
        ctx.beginPath();
        ctx.arc(n.x, n.y, radius, 0, Math.PI * 2);
        ctx.fillStyle = n.color;
        ctx.fill();
        if (n.kind === 'subject' || n.kind === 'hub' || hovered === n.id) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, radius + 3 / scale, 0, Math.PI * 2);
          ctx.strokeStyle = n.color;
          ctx.lineWidth = 1 / scale;
          ctx.stroke();
        }
        if (
          labels?.checked ||
          visibleCount < 14 ||
          n.kind === 'subject' ||
          n.kind === 'hub' ||
          (hovered && neighbors.has(n.id)) ||
          scale > 1.8
        ) {
          const label =
            n.kind === 'hub'
              ? '计算机基础'
              : n.kind === 'chapter'
                ? n.name.split(' · ').pop()!
                : n.name;
          const fontSize = 11 / scale;
          ctx.font = '500 ' + fontSize + 'px ' + getComputedStyle(document.body).fontFamily;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';
          ctx.lineWidth = 3 / scale;
          ctx.strokeStyle = css('--color-surface');
          ctx.strokeText(label, n.x, n.y + radius + 5 / scale);
          ctx.fillStyle = textColor;
          ctx.fillText(label, n.x, n.y + radius + 5 / scale);
        }
        ctx.restore();
      };
      const fg = ForceGraph()(canvas)
        .width(canvas.clientWidth)
        .height(canvas.clientHeight)
        .backgroundColor('rgba(0,0,0,0)')
        .nodeId('id')
        .nodeVal('val')
        .nodeLabel((n: GraphNode) => escape(n.name + ' · ' + n.category))
        .linkWidth((l: RenderLink) => [0, 0.7, 1.8, 3.2][l.strength])
        .linkLabel((l: RenderLink) => escape(l.strength + '/3 · ' + l.descriptions.join('；')))
        .linkColor((l: RenderLink) => {
          if (hovered && id(l.source) !== hovered && id(l.target) !== hovered)
            return 'rgba(120,130,145,.06)';
          return hovered ? mutedColor : 'rgba(120,130,145,' + (0.12 + l.strength * 0.09) + ')';
        })
        .nodeCanvasObject(draw)
        .onNodeClick((n) => {
          location.href = (n as GraphNode).url;
        })
        .onNodeHover((n) => {
          hovered = n ? (n as GraphNode).id : null;
          neighbors = new Set(hovered ? [hovered] : []);
          if (hovered)
            for (const l of visibleLinks)
              if (id(l.source) === hovered || id(l.target) === hovered) {
                neighbors.add(id(l.source));
                neighbors.add(id(l.target));
              }
          canvas.style.cursor = hovered ? 'pointer' : '';
          fg.nodeCanvasObject(draw);
          fg.linkColor(fg.linkColor());
        })
        .onNodeDragEnd((node) => {
          const n = node as RenderNode;
          n.fx = n.x;
          n.fy = n.y;
        })
        .cooldownTicks(70)
        .onEngineStop(() => {
          if (pendingFit) {
            pendingFit = false;
            fg.zoomToFit(250, 50);
          }
        });
      (fg.d3Force('charge') as { strength: (n: number) => void }).strength(-350);
      (fg.d3Force('link') as { distance: (n: number) => void }).distance(110);
      function render() {
        hovered = null;
        neighbors.clear();
        pendingFit = true;
        const nodes = raw.nodes
          .filter(
            (n) =>
              (scope?.value !== 'computer' || n.section === 'computer-foundations') &&
              (!category || category.value === 'all' || n.category === category.value),
          )
          .map((n) => ({ ...n }));
        const ids = new Set(nodes.map((n) => n.id));
        const activeCategories = new Set(nodes.map((n) => n.category));
        for (const item of wrapper.querySelectorAll<HTMLElement>('[data-legend-category]'))
          item.hidden = !activeCategories.has(item.dataset.legendCategory!);
        const links = raw.links
          .filter(
            (l) =>
              ids.has(l.source) && ids.has(l.target) && l.strength >= Number(strength?.value ?? 1),
          )
          .map((l) => ({ ...l }));
        visibleCount = nodes.length;
        visibleLinks = links;
        fg.graphData({ nodes, links });
        wrapper.querySelector('[data-count]')!.textContent =
          nodes.length + ' 节点 · ' + links.length + ' 关系';
        status.textContent = nodes.length ? '' : '此筛选下没有节点，请调整范围或学科。';
        const nodeList = wrapper.querySelector('[data-node-list]')!;
        nodeList.replaceChildren();
        for (const n of nodes) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = n.url;
          a.textContent = n.name;
          li.append(a);
          nodeList.append(li);
        }
        const edgeList = wrapper.querySelector('[data-edge-list]')!;
        edgeList.replaceChildren();
        for (const l of links) {
          const li = document.createElement('li');
          li.textContent = l.strength + '/3 · ' + l.descriptions.join('；');
          edgeList.append(li);
        }
      }
      for (const control of [scope, category, strength])
        control?.addEventListener('change', render);
      labels?.addEventListener('change', () => fg.nodeCanvasObject(draw));
      wrapper.querySelector('[data-reset]')?.addEventListener('click', () => {
        if (scope) scope.value = 'all';
        if (category) category.value = 'all';
        if (strength) strength.value = '1';
        if (labels) labels.checked = false;
        render();
      });
      new ResizeObserver(() => {
        fg.width(canvas.clientWidth).height(canvas.clientHeight);
        fg.zoomToFit(0, 50);
      }).observe(canvas);
      const refresh = () => {
        textColor = css('--color-text');
        mutedColor = css('--color-text-muted');
        fg.nodeCanvasObject(draw);
        fg.linkColor(fg.linkColor());
      };
      new MutationObserver(refresh).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', refresh);
      render();
    } catch (error) {
      status.textContent = '图谱暂时无法加载，可展开下方文字视图继续阅读。';
      console.error(error);
    }
  }
</script>
<style>
  .knowledge-graph {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    min-width: 0;
  }
  .graph-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: end;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  select,
  button {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.45rem 0.6rem;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 5px;
  }
  button {
    cursor: pointer;
  }
  .check-label {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin-top: 0.8rem;
  }
  .graph-canvas {
    width: 100%;
    max-height: 66vh;
    min-height: 280px;
    background-image: radial-gradient(var(--color-border) 0.8px, transparent 0.8px);
    background-size: 20px 20px;
  }
  .graph-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }
  .line-legend,
  .category-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .line-legend span,
  .category-legend span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .line-legend i {
    width: 22px;
    border-top-style: solid;
    border-color: var(--color-text-muted);
  }
  .category-legend {
    padding: 0 1rem 0.8rem;
    font-size: 0.73rem;
    color: var(--color-text-secondary);
  }
  .category-legend [hidden] {
    display: none;
  }
  .category-legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .graph-status {
    margin: 0;
    padding: 0 1rem;
    font-size: 0.8rem;
  }
  .graph-status:empty {
    display: none;
  }
  .graph-text {
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }
  summary {
    cursor: pointer;
  }
  .graph-text ul {
    max-height: 260px;
    overflow: auto;
    overflow-wrap: anywhere;
    padding-left: 1.3rem;
  }
  .graph-text li {
    margin: 0.5rem 0;
  }
  @media (max-width: 500px) {
    .graph-toolbar {
      gap: 0.5rem;
      padding: 0.7rem;
    }
    select {
      max-width: 150px;
    }
    .line-legend {
      gap: 0.4rem 0.8rem;
    }
    .graph-canvas {
      max-height: 55vh;
    }
  }
</style>
