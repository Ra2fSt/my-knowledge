---
import { SITE_TITLE } from '../consts';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <p>
      © {new Date().getFullYear()} {SITE_TITLE} · 由
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      驱动
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
    margin-top: 3rem;
  }

  .footer-inner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-inner p {
    margin: 0;
  }
</style>
