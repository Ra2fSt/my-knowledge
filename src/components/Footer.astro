---
import { SITE_TITLE } from '../consts';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <p>
      © {new Date().getFullYear()} {SITE_TITLE} · 由
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      驱动
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    /* 个别页面（如图谱页）通过覆盖 --footer-margin-top 变量收紧页脚间距 */
    margin-top: var(--footer-margin-top, 3rem);
    padding: 1.5rem 0;
  }

  .footer-inner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-inner p {
    margin: 0;
  }

  /* 页脚链接与周围灰色文字同段落，加下划线保证不靠颜色也能识别 */
  .footer-inner a {
    text-decoration: underline;
  }
</style>
