---
import { SITE_TITLE } from '../consts';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-title">{SITE_TITLE}</p>
      <p class="footer-note">
        用 Markdown 培育的个人知识库。界面配色取自莫奈《撑阳伞的女人》，天空、草坡、阳光与裙摆下的紫灰阴影。
      </p>
    </div>
    <div class="footer-side">
      <div class="footer-palette" aria-label="配色：天空、云、草坡、阳光、阴影">
        <span class="swatch swatch-sky" title="天空"></span>
        <span class="swatch swatch-cloud" title="云"></span>
        <span class="swatch swatch-grass" title="草坡"></span>
        <span class="swatch swatch-sun" title="阳光"></span>
        <span class="swatch swatch-violet" title="阴影"></span>
      </div>
      <p class="footer-meta">
        © {new Date().getFullYear()} {SITE_TITLE} · 由
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 驱动
      </p>
      <p class="footer-links">
        <a href="/about/">关于本站</a>
        <a href="/rss.xml">RSS</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    /* 个别页面（如图谱页）通过覆盖 --footer-margin-top 变量收紧页脚间距 */
    margin-top: var(--footer-margin-top, 4rem);
    padding: 2.4rem 0 2rem;
    background: color-mix(in srgb, var(--color-surface) 48%, transparent);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
  }

  .footer-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-note {
    margin: 0;
    max-width: 42ch;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .footer-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.7rem;
    text-align: right;
  }

  .footer-palette {
    display: flex;
    gap: 0.28rem;
  }

  .swatch {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .swatch-sky {
    background: var(--color-sky);
  }

  .swatch-cloud {
    background: var(--color-cloud);
  }

  .swatch-grass {
    background: var(--color-grass);
  }

  .swatch-sun {
    background: var(--color-sun);
  }

  .swatch-violet {
    background: var(--color-violet);
  }

  .footer-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .footer-meta a {
    color: inherit;
    text-decoration-color: currentColor;
  }

  .footer-links {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    font-size: 0.76rem;
  }

  .footer-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .footer-side {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
