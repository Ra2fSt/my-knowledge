---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/learn/', label: '计算机基础' },
  { href: '/notes/', label: '笔记' },
  { href: '/categories/', label: '分类' },
  { href: '/tags/', label: '标签' },
  { href: '/graph/', label: '图谱' },
  { href: '/about/', label: '关于' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  // path 已去掉末尾斜杠，href 也要去掉再比较，否则 /notes 对不上 /notes/
  return path.startsWith(href.replace(/\/+$/, ''));
}
---

<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a class="site-title" href="/" aria-label={`${SITE_TITLE} 首页`}>
      <span class="brand-mark" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span class="brand-copy">
        <span class="brand-name">{SITE_TITLE}</span>
        <span class="brand-tag">DIGITAL GARDEN</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button class="icon-button search-button" type="button" aria-label="搜索">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8"></path>
        </svg>
        <span>搜索</span>
      </button>
      <ThemeToggle />
    </div>

    <details class="mobile-menu">
      <summary class="icon-button" aria-label="打开菜单">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>
      <div class="mobile-menu-panel">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px) saturate(1.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.6vw, 2.2rem);
    height: var(--header-height);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-title:hover {
    color: var(--color-text);
  }

  .brand-mark {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 1.55rem;
    height: 1.55rem;
    align-items: end;
    flex-shrink: 0;
  }

  .brand-mark i {
    display: block;
    width: 100%;
  }

  .brand-mark i:nth-child(1) {
    height: 100%;
    background: var(--color-sky);
  }

  .brand-mark i:nth-child(2) {
    height: 72%;
    background: var(--color-grass);
  }

  .brand-mark i:nth-child(3) {
    height: 88%;
    background: var(--color-sun);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    gap: 0.15rem;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.55rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0;
    height: 2px;
    background: var(--color-sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.2rem;
    flex-shrink: 0;
  }

  .mobile-menu {
    display: none;
    position: relative;
    margin-left: 0.2rem;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    padding: 0.35rem 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    box-shadow: 6px 6px 0 var(--color-sky-soft);
  }

  .mobile-menu-panel a {
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .mobile-menu-panel a:first-child {
    border-top: 0;
  }

  .mobile-menu-panel a:hover {
    background: var(--color-sky-soft);
    color: var(--color-accent);
  }

  .mobile-menu-panel a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 1080px) {
    .site-nav {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 620px) {
    /* 移动端保留搜索入口：隐藏文字、只留图标（触屏没有 Ctrl+K 快捷键） */
    .search-button {
      min-width: 2.35rem;
      padding: 0.4rem;
    }

    .search-button span {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .brand-tag {
      display: none;
    }
  }
</style>
