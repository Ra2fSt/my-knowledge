---
import { statusLabel } from '../lib/status';
import type { NoteStatus } from '../lib/status';

interface Props {
  status: NoteStatus;
}

const { status } = Astro.props;
---

<span class="status-badge" data-status={status}>{statusLabel(status)}</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-badge[data-status='learning'] {
    color: var(--color-learning);
  }

  .status-badge[data-status='learning']::before {
    background: var(--color-learning);
  }

  .status-badge[data-status='organizing'] {
    color: var(--color-organizing);
  }

  .status-badge[data-status='organizing']::before {
    background: var(--color-organizing);
  }

  .status-badge[data-status='mastered'] {
    color: var(--color-mastered);
  }

  .status-badge[data-status='mastered']::before {
    background: var(--color-mastered);
  }

  .status-badge[data-status='archived'] {
    color: var(--color-archived);
  }

  .status-badge[data-status='archived']::before {
    background: var(--color-archived);
  }
</style>
